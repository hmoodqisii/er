            spoofStatusLbl.Text = string.format("✅ %s — %d كائن مزور", spoof.device, spoof.patches)
            spoofStatusLbl.TextColor3 = C.GREEN
        elseif spoof.hooked then
            spoofStatusLbl.Text = "Hook جاهز — ينتظر SetDevice"
            spoofStatusLbl.TextColor3 = C.MUTED
        end
    end
end)

