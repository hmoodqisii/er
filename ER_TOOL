-- [8] نظام Lock-On والهدف
local targetHL = mk("Highlight", {Name = "ER_TargetESP", FillColor = Color3.fromRGB(255, 0, 0), FillTransparency = 0.6, OutlineColor = Color3.fromRGB(255, 255, 255), OutlineTransparency = 0, Enabled = false}, CoreGui)
local curTarget, lockedName

task.spawn(function()
    while mainGui.Parent do
        task.wait(0.25)
        if not lockOn() and not magnetActive then
            lockedName = nil
            curTarget = nil
            targetHL.Enabled = false
            targetHL.Adornee = nil
            continue
        end
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and root) then continue end
        local myPos = root.Position
        
        local best, bestD = nil, math.huge
        for _, v in ipairs(Players:GetPlayers()) do
            if v ~= lp and v.Character then
                local tr = v.Character:FindFirstChild("HumanoidRootPart")
                local hm = v.Character:FindFirstChild("Humanoid")
                if tr and hm and hm.Health > 0 then
                    local d = (myPos - tr.Position).Magnitude
                    if d < bestD then bestD = d; best = v end
                end
            end
        end
        if best then
            curTarget = best
            targetHL.Adornee = best.Character
            targetHL.Enabled = true
        else
            targetHL.Enabled = false
            targetHL.Adornee = nil
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not (lockOn() or magnetActive) or not lp.Character then return end
    local char = lp.Character
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not (hum and root and curTarget and curTarget.Character) then return end
    local tr = curTarget.Character:FindFirstChild("HumanoidRootPart")
