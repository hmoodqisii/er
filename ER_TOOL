local debounce = true; local rP = RaycastParams.new(); rP.FilterType = Enum.RaycastFilterType.Exclude
local function getWall()
    local c = lp.Character; local r = c and c:FindFirstChild("HumanoidRootPart"); if not r then return nil end
    rP.FilterDescendantsInstances = {c}; local h, md = nil, 2.6
    for _, d in ipairs({r.CFrame.LookVector, -r.CFrame.LookVector, r.CFrame.RightVector, -r.CFrame.RightVector}) do
        local ry = workspace:Raycast(r.Position, d * 2.5, rP); if ry and ry.Distance < md then md = ry.Distance; h = ry end
