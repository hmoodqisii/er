local function cfgSave(d)
    if writefile then
        pcall(function()
            writefile(CFG, d)
            logDebug("Storage", "تم حفظ إعداد الجهاز: " .. tostring(d))
        end)
    end
end

local function cfgLoad()
    if not readfile or not isfile or not isfile(CFG) then return nil end
    local ok, v = pcall(function() return readfile(CFG) end)
    if ok and v then
        local d = v:match("^%s*(%a+)%s*$")
        if d and VALID[d] then
            logDebug("Storage", "تم تحميل الإعداد المحفوظ: " .. tostring(d))
            return d
        end
    end
    return nil
end

local function gcWalk(device)
    if not getgc or not device then
        logDebug("GCWalk", "getgc غير متوفر أو الجهاز غير مسجل.")
        return 0
    end
    local ok, pool = pcall(function() return getgc(true) end)
    if not ok or type(pool) ~= "table" then return 0 end
    local n = 0
    for i, obj in ipairs(pool) do
        if i > 180000 then break end
        if type(obj) ~= "table" then continue end
        local ok1, cur = pcall(function() return rawget(obj, "Device") end)
        if ok1 and VALID[cur] and cur ~= device then
            pcall(function() rawset(obj, "Device", device) end)
            n += 1
            local ok2, fn = pcall(function() return rawget(obj, "FixXCoordinateAspectRate") end)
            if ok2 and type(fn) == "function" then pcall(function() fn(obj) end) end
        end
        local ok3, pref = pcall(function() return rawget(obj, "PreferredInput") end)
        if ok3 and type(pref) == "table" then
            local wk = device == "Console" and "Gamepad" or (device == "Mobile" and "Touch" or "Keyboard")
            local ok4, w = pcall(function() return rawget(obj, wk) end)
            if ok4 and type(w) == "table" and pref ~= w then
                pcall(function() rawset(obj, "PreferredInput", w) end)
            end
        end
    end
    logDebug("GCWalk", string.format("تم تطبيق التعديلات على %d كائن بنجاح للجهاز: %s", n, device))
    return n
end

local function hookSD(SD, device, cb)
    if spoof.cleanup then pcall(function() spoof.cleanup() end) end
    spoof.SD = SD
    spoof.hooked = false
    spoof.cleanup = nil
    local fired = false

    if hookfunction and newcclosure then
        local old
        local ok = pcall(function()
            old = hookfunction(SD.FireServer, newcclosure(function(self, ...)
                if self == SD and not fired then
                    fired = true
                    spoof.hooked = true
                    task.spawn(function()
                        local n = gcWalk(device)
                        spoof.patches = n
                        if cb then cb(n) end
                    end)
                    return old(self, device)
                end
                return old(self, ...)
            end))
        end)
        if ok then
            spoof.cleanup = function() pcall(function() hookfunction(SD.FireServer, old) end) end
            logDebug("Hook", "تم تفعيل hookfunction بنجاح لـ SetDevice.")
            return true
        end
    end

    if hookmetamethod and newcclosure and getrawmetatable and setreadonly then
        local mt = getrawmetatable(game)
        if mt then
            local oi = mt.__namecall
            local ok = pcall(function()
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    if getnamecallmethod() == "FireServer" and self == SD and not fired then
                        fired = true
                        spoof.hooked = true
                        task.spawn(function()
                            local n = gcWalk(device)
                            spoof.patches = n
                            if cb then cb(n) end
                        end)
                        return oi(self, device)
                    end
                    return oi(self, ...)
                end)
                setreadonly(mt, true)
            end)
            if ok then
                spoof.cleanup = function()
                    pcall(function()
                        setreadonly(mt, false)
                        mt.__namecall = oi
                        setreadonly(mt, true)
                    end)
                end
                logDebug("Hook", "تم تفعيل hookmetamethod بنجاح لـ SetDevice.")
                return true
            end
        end
    end
    logDebug("Hook", "فشل ربط SetDevice، سيتم الاعتماد على gcWalk المباشر.")
    return false
end

