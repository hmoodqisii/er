-- ═══════════════════════════════════════
local VALID_DEVICES = {Console = true, Mobile = true, PC = true}

local DeviceSpoofer = {
    currentDevice = nil,
    hookCleanup   = nil,
    applied       = false,
    patchCount    = 0,
    listeners     = {},
}

local function canHook()
    if hookmetamethod and newcclosure and getrawmetatable and setreadonly then return "meta" end
    if hookfunction and newcclosure then return "func" end
    return nil
end

local function gcWalk(device)
    if not getgc then dbg("getgc غير متاح"); return 0 end
    local ok, pool
    if filtergc then
        ok, pool = pcall(function()
            return filtergc("table", true, {Device = true})
        end)
    end
    if not ok or not pool then
        ok, pool = pcall(function() return getgc(true) end)
    end
    if not ok or type(pool) ~= "table" then return 0 end

    local n = 0
    for i, obj in ipairs(pool) do
        if i > 200000 then break end
        if type(obj) ~= "table" then continue end

        local ok1, cur = pcall(rawget, obj, "Device")
        if ok1 and VALID_DEVICES[cur] and cur ~= device then
            pcall(rawset, obj, "Device", device)
            n += 1
            local ok2, fn = pcall(rawget, obj, "FixXCoordinateAspectRate")
            if ok2 and type(fn) == "function" then pcall(fn, obj) end
        end

        local ok3, pref = pcall(rawget, obj, "PreferredInput")
        if ok3 and type(pref) == "table" then
            local wk = device == "Console" and "Gamepad"
                    or device == "Mobile"  and "Touch"
                    or "Keyboard"
            local ok4, w = pcall(rawget, obj, wk)
            if ok4 and type(w) == "table" and pref ~= w then
                pcall(rawset, obj, "PreferredInput", w)
            end
        end
    end
    dbg("gcWalk: " .. n .. " كائن ← " .. device)
    return n
end

function DeviceSpoofer:installHook(SD, device)
    if self.hookCleanup then
        pcall(self.hookCleanup)
        self.hookCleanup = nil
    end

    local mode = canHook()
    if not mode then
        dbg("لا توجد طريقة hook متاحة")
        return false
    end

    local fired = false
    local self_ = self

    if mode == "meta" then
        local mt = getrawmetatable(game)
        if not mt then return false end
        local origNC = mt.__namecall

        local ok = pcall(function()
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(obj, ...)
                local method = getnamecallmethod()
                if method == "FireServer" and obj == SD and not fired then
                    if checkcaller and checkcaller() then
                        return origNC(obj, ...)
                    end
                    fired = true
                    self_.applied = true
                    task.spawn(function()
                        local n = gcWalk(device)
                        self_.patchCount = n
                        dbg("Hook نجح ← " .. device .. " (" .. n .. " كائن)")
                        for _, fn in ipairs(self_.listeners) do pcall(fn, device, n) end
                    end)
                    return origNC(obj, device)
                end
                return origNC(obj, ...)
            end)
            setreadonly(mt, true)
        end)

        if ok then
            self.hookCleanup = function()
                pcall(function()
                    setreadonly(mt, false)
                    mt.__namecall = origNC
                    setreadonly(mt, true)
                end)
            end
            dbg("Hook مثبّت عبر hookmetamethod")
            return true
        end

    elseif mode == "func" then
        local old
        local ok = pcall(function()
            old = hookfunction(SD.FireServer, newcclosure(function(obj, ...)
                if obj == SD and not fired then
                    fired = true
                    self_.applied = true
                    task.spawn(function()
                        local n = gcWalk(device)
                        self_.patchCount = n
                        dbg("Hook نجح ← " .. device)
                        for _, fn in ipairs(self_.listeners) do pcall(fn, device, n) end
                    end)
                    return old(obj, device)
                end
                return old(obj, ...)
            end))
        end)
        if ok then
            self.hookCleanup = function() pcall(hookfunction, SD.FireServer, old) end
            dbg("Hook مثبّت عبر hookfunction")
            return true
        end
    end

    return false
end

function DeviceSpoofer:apply(device, SD)
    if not VALID_DEVICES[device] then return false end
    self.currentDevice = device
    watchLock()
    if SD then self:installHook(SD, device) end
    task.spawn(function()
        task.wait(0.5)
        self.patchCount = gcWalk(device)
    end)
    return true
end

function DeviceSpoofer:onApplied(fn)
    table.insert(self.listeners, fn)
end

function DeviceSpoofer:cleanup()
    if self.hookCleanup then
        pcall(self.hookCleanup)
        self.hookCleanup = nil
    end
    self.applied = false
    dbg("DeviceSpoofer: cleanup")
end

