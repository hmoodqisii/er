local VALID_DEVICES = {Console = true, Mobile = true, PC = true}
local DeviceSpoofer = { currentDevice = nil, listeners = {} }

function DeviceSpoofer:apply(device)
    if not VALID_DEVICES[device] then return false end
    self.currentDevice = device
    Storage.save("device", device)
    for _, fn in ipairs(self.listeners) do pcall(fn, device) end
    return true
end

function DeviceSpoofer:onApplied(fn)
    table.insert(self.listeners, fn)
end

function DeviceSpoofer:cleanup()
    Storage.delete("device")
end

