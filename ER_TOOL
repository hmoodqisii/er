end

UIS.JumpRequest:Connect(function()
    if not hopOn() or not debounce then return end
    local c = lp.Character; local hum = c and c:FindFirstChildOfClass("Humanoid"); local r = c and c:FindFirstChild("HumanoidRootPart")
    if not (hum and r and hum.Health > 0) then return end
    local w = getWall(); if not w then return end
    debounce = false; local wn = w.Normal; local hwn = Vector3.new(wn.X, 0, wn.Z).Unit
    if hwn.Magnitude < 0.1 then hwn = (r.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit end
    local b = hwn; local hcl = Vector3.new(CAM.CFrame.LookVector.X, 0, CAM.CFrame.LookVector.Z).Unit
    local dt = math.clamp(b:Dot(hcl), -1, 1); local ab = math.acos(dt); local cr = b:Cross(hcl); local rs = math.sign(cr.Y)
    if rs == 0 then ab = 0 end
    local it = CFrame.Angles(0, math.min(ab, math.rad(40)) * rs, 0) * b
    r.CFrame = CFrame.lookAt(r.Position, r.Position + it); RunService.Heartbeat:Wait()
    hum:ChangeState(Enum.HumanoidStateType.Jumping); r.CFrame = CFrame.lookAt(r.Position, r.Position - b)
