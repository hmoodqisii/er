local function patchTable(obj, device)
  local patched, relevant = 0, false
  for _, keyName in ipairs(DEVICE_KEYS) do
    local okK, cur = pcall(rawget, obj, keyName)
    if okK and isDevValue(cur) then
      relevant = true
      if cur ~= device then
        unlockTable(obj)
