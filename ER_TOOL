local function loadSettings()
    local path = "ER_Data/" .. CFG_FILE
    if type(readfile) == "function" and type(isfile) == "function" and isfile(path) then
        local ok, v = pcall(function() return readfile(path) end)
        if ok and v then
            local d = v:match("^%s*(%a+)%s*$")
            if d and VALID_DEVICES[d] then
                debugLog("تم استرجاع الإعدادات المحفوظة: " .. tostring(d))
                return d
            end
        end
    elseif type(readfile) == "function" then
        -- محاولة القراءة المباشرة إن لم تتواجد المجلدات
        local ok, v = pcall(function() return readfile(CFG_FILE) end)
        if ok and v then
            local d = v:match("^%s*(%a+)%s*$")
            if d and VALID_DEVICES[d] then return d end
        end
    end
    return nil
end

-- [5] Device Spoofer الأساسي مع فحص توفر الوظائف
local spoof = {device = nil, SD = nil, hooked = false, cleanup = nil, patches = 0}

local function gcWalk(targetDevice)
    if type(getgc) ~= "function" or not targetDevice then return 0 end
    local ok, pool = pcall(function() return getgc(true) end)
    if not ok or type(pool) ~= "table" then return 0 end
    local n = 0
    for i, obj in ipairs(pool) do
        if i > 150000 then break end
        if type(obj) ~= "table" then continue end
        
        local ok1, cur = pcall(function() return rawget(obj, "Device") end)
        if ok1 and VALID_DEVICES[cur] and cur ~= targetDevice then
            pcall(function() rawset(obj, "Device", targetDevice) end)
            n += 1
            local ok2, fn = pcall(function() return rawget(obj, "FixXCoordinateAspectRate") end)
            if ok2 and type(fn) == "function" then pcall(function() fn(obj) end) end
        end
        
        local ok3, pref = pcall(function() return rawget(obj, "PreferredInput") end)
        if ok3 and type(pref) == "table" then
            local wk = targetDevice == "Console" and "Gamepad" or (targetDevice == "Mobile" and "Touch" or "Keyboard")
            local ok4, w = pcall(function() return rawget(obj, wk) end)
            if ok4 and type(w) == "table" and pref ~= w then
                pcall(function() rawset(obj, "PreferredInput", w) end)
            end
        end
    end
    debugLog("Device Spoofer GC Walk executed. Patched objects: " .. tostring(n))
    return n
end

local function hookSD(SD, targetDevice, cb)
    if spoof.cleanup then pcall(function() spoof.cleanup() end) end
    spoof.SD = SD
    spoof.hooked = false
    spoof.cleanup = nil
    local fired = false

    if type(hookfunction) == "function" and type(newcclosure) == "function" then
        local old
        local ok = pcall(function()
            old = hookfunction(SD.FireServer, newcclosure(function(self, ...)
                if self == SD and not fired then
                    fired = true
                    spoof.hooked = true
                    task.spawn(function()
                        local n = gcWalk(targetDevice)
                        spoof.patches = n
                        if cb then cb(n) end
                    end)
                    return old(self, targetDevice)
                end
                return old(self, ...)
            end))
        end)
        if ok then
            spoof.cleanup = function() pcall(function() hookfunction(SD.FireServer, old) end) end
            debugLog("تم تطبيق Hook بنجاح عبر hookfunction")
            return true
        end
    end

    if type(hookmetamethod) == "function" and type(getrawmetatable) == "function" and type(setreadonly) == "function" then
        local mt = getrawmetatable(game)
        if mt then
            local oi = mt.__namecall
            local ok = pcall(function()
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    if type(getnamecallmethod) == "function" and getnamecallmethod() == "FireServer" and self == SD and not fired then
                        fired = true
                        spoof.hooked = true
                        task.spawn(function()
                            local n = gcWalk(targetDevice)
                            spoof.patches = n
                            if cb then cb(n) end
                        end)
                        return oi(self, targetDevice)
                    end
                    return oi(self, ...)
                end)
                setreadonly(mt, true)
            end)
            if ok then
                spoof.cleanup = function()
                    pcall(function()
                        setreadonly(mt, false)
                        mt.__namecall = oi
                        setreadonly(mt, true)
                    end)
                end
                debugLog("تم تطبيق Hook بنجاح عبر hookmetamethod")
                return true
            end
        end
    end

    debugLog("فشل تطبيق الـ Hook عبر الأدوات المتاحة.")
    return false
end

