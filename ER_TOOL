function TrueJoin.rejoin(placeId, jobId, device, uiMode, SD)
    if not VALID_DEVICES[device] then
        dbg("TrueJoin: جهاز غير صالح")
        return false
    end

    DeviceSpoofer.currentDevice = device
    TrueJoin.queueReload(device, uiMode)

    local finished, stage, conn = false, 1, nil

    local function applyInPlace()
        if finished then return end
        finished = true
        if conn then conn:Disconnect(); conn = nil end
        hideTeleportError()

        DeviceSpoofer.currentDevice = device
        watchLock()
        if SD then
            pcall(function() DeviceSpoofer:installHook(SD, device) end)
        end

        -- إعادة تطبيق الجهاز عدة مرات إذا تعذر الانتقال، مثل آلية ASTA.
        for i = 1, 10 do
            task.delay((i - 1) * 0.6, function()
                if not _G.ER_LOADED then return end
                pcall(gcWalk, device)
            end)
        end
        dbg("تعذرت إعادة الانضمام؛ أُعيد تطبيق " .. device .. " في السيرفر الحالي")
    end

    local function finish(result, msg)
        if result ~= nil or msg ~= nil then
            dbg("Rejoin failed: " .. tostring(result) .. " | " .. tostring(msg))
        end
        applyInPlace()
    end

    local function tryAsync()
        return pcall(function()
            local opts = Instance.new("TeleportOptions")
            opts.ServerInstanceId = jobId
            TeleportService:TeleportAsync(placeId, {lp}, opts)
        end)
    end

    conn = TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
        if finished then return end
        hideTeleportError()
        if stage == 1 then
            stage = 2
            task.spawn(function()
                if not tryAsync() then finish(result, msg) end
            end)
        else
            finish(result, msg)
        end
    end)

    local okTp = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, lp)
    end)

    if not okTp then
        stage = 2
        task.spawn(function()
            if not tryAsync() then finish("pcall", "teleport api error") end
        end)
    end

    task.delay(10, function()
        if not finished then finish() end
    end)
    return true
end

