-- ═══════════════════════════════════════
local FOLDER = "ER_Settings"
local Storage = {}

function Storage.init()
    if isfolder and not isfolder(FOLDER) then
        if makefolder then pcall(makefolder, FOLDER) end
    end
end

function Storage.save(key, value)
    if not writefile then return false end
    local ok = pcall(writefile, FOLDER .. "/" .. key .. ".bin", tostring(value))
    return ok
end

function Storage.load(key)
    if not readfile then return nil end
    local path = FOLDER .. "/" .. key .. ".bin"
    if isfile and not isfile(path) then return nil end
    local ok, v = pcall(readfile, path)
    if ok and v and #v > 0 then return v:match("^%s*(.-)%s*$") end
    return nil
end

Storage.init()

