local shiftLockOn, cursorRef = false, nil
local function lockFix(inst)
    if not inst:IsA("GuiObject") then return end
    local n = inst.Name
    if n == "ConsoleButton" then inst.Visible = false
    elseif n == "ShiftLockArea" then inst.Visible = true
    elseif n == "Toggle" and inst.Parent and inst.Parent.Name == "ShiftLockArea" then
        inst.Visible = true
        if inst:IsA("GuiButton") and not inst:GetAttribute("Fixed") then
            inst:SetAttribute("Fixed", true)
            inst.MouseButton1Click:Connect(function()
                shiftLockOn = not shiftLockOn
                if cursorRef then cursorRef.Visible = shiftLockOn end
            end)
        end
    elseif n == "MouseLockedCursor" then
        cursorRef = inst
        inst.Visible = shiftLockOn
    end
end

