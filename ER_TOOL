-- Device Spoofer (معالجة الحفظ المزدوج عبر الملفات و _G لضمان عدم الضياع)
local VALID = { Console = true, Mobile = true, PC = true }
local CFG = "er_dspoofcfg_v6.bin"
local spoof = { device = _G.ER_SELECTED_DEVICE or nil, SD = nil, hooked = false, cleanup = nil, patches = 0 }

local function cfgSave(d)
    _G.ER_SELECTED_DEVICE = d
    if writefile then
        pcall(function() writefile(CFG, d) end)
    end
end

local function cfgLoad()
    if _G.ER_SELECTED_DEVICE and VALID[_G.ER_SELECTED_DEVICE] then
        return _G.ER_SELECTED_DEVICE
    end
    if readfile then
        local ok, v = pcall(function() return readfile(CFG) end)
        if ok and v then
            local d = v:match("^%s*(%a+)%s*$")
            if d and VALID[d] then
                _G.ER_SELECTED_DEVICE = d
                return d
            end
        end
    end
    return nil
end

local function gcWalk(device)
    if not getgc or not device then return 0 end
    local ok, pool = pcall(function() return getgc(true) end)
    if not ok or type(pool) ~= "table" then return 0 end
    local n = 0
    for i, obj in ipairs(pool) do
        if i > 150000 then break end
        if type(obj) ~= "table" then continue end
        local ok1, cur = pcall(function() return rawget(obj, "Device") end)
        if ok1 and (cur == "PC" or cur == "Mobile" or cur == "Console") then
            pcall(function() rawset(obj, "Device", device) end)
            n = n + 1
        end
    end
    return n
end

local function hookSD(SD, device, cb)
    if spoof.cleanup then pcall(function() spoof.cleanup() end) end
    spoof.SD = SD
    spoof.hooked = false
    spoof.cleanup = nil
    local fired = false
    
    if hookfunction and newcclosure then
        local old
        local ok = pcall(function()
            old = hookfunction(SD.FireServer, newcclosure(function(self, ...)
                if self == SD and not fired then
                    fired = true
                    spoof.hooked = true
                    task.spawn(function()
                        local n = gcWalk(device)
                        spoof.patches = n
                        if cb then cb(n) end
                    end)
                    return old(self, device)
                end
                return old(self, ...)
            end))
        end)
        if ok then
            spoof.cleanup = function() pcall(function() hookfunction(SD.FireServer, old) end) end
            return true
        end
    end
    return false
end

